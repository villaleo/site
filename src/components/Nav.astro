---
import { NAV_ITEMS } from "../config";
import "../styles/global.css";

const {class: className, ...rest} = Astro.props;
---

<div class:list={[className]} {...rest}>
    <nav class="text-text font-silkscreen grid grid-cols-1 sm:grid-cols-3 gap-1.5">
        {NAV_ITEMS.map(({path, title}) => (
            <a
                class="nav-link"
                href={path}
                aria-label={title}
            >
                <div class="p-1 nav-item">
                    {title}
                </div>
            </a>
        ))}
    </nav>
</div>

<style>
    @reference "../styles/global.css";

    .nav-link {
        @apply hover:cursor-default hover:text-secondary active:text-secondary;
    }
    
    .nav-item {
        @apply border-2 border-primary hover:border-secondary active:border-secondary
    }
</style>
