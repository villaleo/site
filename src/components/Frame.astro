---
import "../styles/global.css";

interface Props {
    label?: string;
    noBorder?: boolean;
    class?: string;
}

const {
    label,
    class: className,
    ...rest
} = Astro.props as Props;
---

<div class="border-primary-md">
    <div class='overflow-scroll' class:list={[className]} {...rest}>
        <slot />
    </div>
</div>
<div class="p-1 px-2 mt-1 mb-5 text-background font-silkscreen bg-primary inline-block">
    <span>{label}</span>
</div>
