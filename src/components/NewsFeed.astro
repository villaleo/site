---
import "../styles/global.css";
import type { NewsfeedItem } from "../types";

import { getCollection } from "astro:content";

function mostRecentNewsfeedItem(a: NewsfeedItem, b: NewsfeedItem): number {
    return b.publicationDate.getTime() - a.publicationDate.getTime();
}

const newsfeed: NewsfeedItem[] = await getCollection('newsfeed')
    .then(feed => feed.map(item => item.data))
    .then(feed => feed.toSorted(mostRecentNewsfeedItem))
    .catch(error => {
        Astro.logger.warn('failed to load newsfeed collection:');
        Astro.logger.warn(error);
        return [];
    })
---

<ul class="bg-background">
    {newsfeed.map(({title, url, description, publicationDate}) => (
        <a class="block even:bg-background-secondary" href={url}>
            <li class="p-3.5 link">
                <p class="font-silkscreen">{title}</p>
                <p class="mb-4">{publicationDate.toDateString()}</p>
                <p class="line-clamp-2" >{description}</p>
            </li>
        </a>
    ))}
</ul>

<style>
    @reference "../styles/global.css";
    
    .link {
        @apply hover:cursor-pointer hover:text-secondary active:text-secondary;
    }
</style>
