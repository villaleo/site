---
import Frame from "../components/Frame.astro";
import Nav from "../components/Nav.astro";
import NewsFeed from "../components/NewsFeed.astro";
import Root from "../layouts/Root.astro";
import { SITE } from "../config";

import { getCollection } from "astro:content";

export const prerender = false

const greetings = await getCollection('greetings')
    .then(entries => entries.map(entry => entry.data.msg))
    .catch(error => {
        Astro.logger.warn('failed to load greetings collection:');
        Astro.logger.warn(error);
        Astro.logger.info('using default greetings instead.');
        return ['hello', 'welcome'];
    });

const greetIndex = Math.floor(Math.random() * greetings.length);
const greetMsg = greetings[greetIndex];
---

<Root title={SITE.title}>
    <main class="p-5 h-screen flex flex-col gap-5 lg:flex lg:flex-row lg:gap-15 lg:p-20">
        <header class="lg:w-[65%]">
            <Nav class:list={'mb-10'} />
            <Frame label="Developed by Leo Villalobos">
                <div class="p-3.5">
                    <h1 class="text-2xl md:text-3xl lg:text-4xl text-primary font-source-serif">
                        {greetMsg}
                    </h1>
                    <p class="mt-2">
                        Welcome to my digital space! It's not much (yet), but it's
                        honest work.
                    </p>
                    <p class="mt-2.5 text-secondary">
                        Zero AI was used in the development of this site.
                    </p>
                </div>
            </Frame>
        </header>
        <section id="news-feed" class="lg:w-[35%]">
            <Frame label="News • Pivot to AI" class:list={['h-100 lg:h-200']}>
                <NewsFeed />
            </Frame>
        </section>
    </main>
</Root>
