---
import { Font } from "astro:assets";
import "../styles/global.css";

interface Props {
    title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <link rel="icon" type="image/svg+xml" href="favicon.svg" />
        <Font cssVariable="--font-silkscreen" preload />
        <Font cssVariable="--font-unifontex" preload />
        <Font cssVariable="--font-source-serif" preload />
        <title>{title}</title>
        <style>
            * {
                font-family: var(--font-silkscreen);
            }
        </style>
    </head>
    <body>
        <slot />
    </body>
</html>
