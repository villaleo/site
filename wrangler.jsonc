{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "compatibility_date": "2026-11-10",
    "compatibility_flags": ["global_fetch_strictly_public"],
    "name": "site",
    "main": "@astrojs/cloudflare/entrypoints/server",
    "assets": {
        "directory": "./dist",
        "binding": "ASSETS",
    },
    "observability": {
        "enabled": true,
    },
    "vars": {
        "DO_NOT_TRACK": "1",
        "WRANGLER_SEND_METRICS": "false",
    },
}
